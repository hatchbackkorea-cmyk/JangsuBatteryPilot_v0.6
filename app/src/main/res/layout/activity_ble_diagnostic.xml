<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootBleDiagnostic"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBleBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="← 설정"
                android:textSize="11sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Avinox BLE 실험실"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/panel_accent_bg"
            android:padding="8dp"
            android:text="진단 전용 · 여기서 읽은 값은 배터리 예측/개인학습에 반영되지 않습니다."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="9dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 자전거 찾기"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvBleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:text="자전거 전원 ON → 주변 BLE 검색. 연결이 안 되면 Avinox 앱을 완전히 종료하세요."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnBleScan"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="BLE 검색"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnBleStop"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="중지"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnBleDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:text="연결 해제"
                    android:textSize="11sp" />
            </LinearLayout>
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/pill_bg"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/bleDeviceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="3dp" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="9dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. 배터리 값 대조"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etBleBattery"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent"
                    android:hint="현재 % 예: 66"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnBleCompare"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:minHeight="0dp"
                    android:text="대조"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvBleCandidate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:text="후보가 여기에 표시됩니다."
                android:textColor="@color/good"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="9dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. 원시 데이터 미리보기"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvBleRaw"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:gravity="top"
                android:maxLines="4"
                android:text="Characteristic 데이터가 아직 없습니다."
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/panel_accent_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4. 진단 로그"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnBleSave"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:text="로그 저장"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
