<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stravaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button android:id="@+id/btnStravaBack" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← 설정" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="STRAVA" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_accent_bg" android:orientation="vertical" android:padding="13dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="계정 연결" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvStravaClientId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Client ID" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tvStravaStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="○ Strava 연결 안 됨" android:textColor="@color/text_primary" android:textSize="13sp" />
            <EditText android:id="@+id/etStravaSecret" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:hint="Client Secret · 이 휴대폰에만 입력" android:inputType="textPassword" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnStravaSaveSecret" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Secret 저장" />
                <Button android:id="@+id/btnStravaConnect" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Strava 연결" />
            </LinearLayout>
            <Button android:id="@+id/btnStravaDisconnect" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="연결 해제" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ROAD 과거 라이딩 분석을 위해 읽기 권한을 요청합니다. Secret·토큰은 Android Keystore 암호화 저장소에만 보관합니다." android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="13dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avinox FIT + 우리 BLE → 클린 Strava FIT" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Rider Power · 심박 · 케이던스 · GPS · 고도 · 속도 · Motor Power · 실제 배터리 · 선택 모드를 가능한 한 모두 넣습니다. 없는 값은 꾸며내지 않습니다." android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/btnStravaPickFit" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="Avinox FIT 선택" />
            <TextView android:id="@+id/tvStravaFitPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="FIT를 선택하면 같은 주행의 우리 BLE 로그를 자동으로 찾아 합칩니다." android:textColor="@color/text_primary" android:textSize="12sp" />
            <Button android:id="@+id/btnStravaUpload" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:enabled="false" android:text="클린 FIT → STRAVA 업로드" />
            <Button android:id="@+id/btnStravaUploadOriginal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:enabled="false" android:text="원본 FIT 직접 업로드 (비교)" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="※ 표준 FIT power에는 반드시 사람이 낸 Rider Power만 넣습니다. Motor Power는 FIT의 별도 e-bike 필드로 기록합니다. Strava가 e-bike 전용 필드를 화면에 표시하지 않더라도 Motor/Battery/Mode 요약은 활동 설명에 함께 올라갑니다." android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
