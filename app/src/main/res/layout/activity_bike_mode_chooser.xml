<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBikeModeVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Copilot"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBikeModeServerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/panel"
            android:gravity="center"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="PC 서버 상태 확인 중…"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="오늘 어떤 자전거로 탈까요?"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBikeModeCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="⬆ 앱 업데이트 확인"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBikeModeEmtb"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="12dp"
            android:text="⚡ eMTB\n배터리 코파일럿"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBikeModeRoad"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="14dp"
            android:text="🚴 ROAD\n그란폰도 페이스 코치"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBikeModeAdmin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="🔐 관리자 · 업데이트 / Rider Control Center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="그룹방 참가: ROAD → 그란폰도 페이스 코치에서 확인 · 앱 업데이트는 일반 사용자도 가능합니다."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
