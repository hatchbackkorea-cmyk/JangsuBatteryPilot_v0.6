                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="휴대폰 사용 순서" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
