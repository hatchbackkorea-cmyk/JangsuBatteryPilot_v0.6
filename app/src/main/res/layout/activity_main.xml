                    <TextView android:id="@+id/tvPageFinishTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="충전권장 기준 잔량" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <SeekBar android:id="@+id/seekPageFinishTarget" android:layout_width="match_parent" android:layout_height="22dp" android:minHeight="0dp" />
                    <TextView android:id="@+id/tvPageHardReserve" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="비상 하드 리저브 7%" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
