                    <Switch android:id="@+id/switchPageKeepScreen" android:layout_width="match_parent" android:layout_height="28dp" android:minHeight="0dp" android:text="주행 중 화면 켜짐 유지" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvPageDistanceInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="거리 기준 안내" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
