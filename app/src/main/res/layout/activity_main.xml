                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="SRAM 장치 검색 → 연결 → GATT 수집 → 변속 전후 UUID 자동 분석. WRITE 명령은 보내지 않습니다." android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/tvPageUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="현재 앱 버전 확인 중…" android:textColor="@color/text_secondary" android:textSize="12sp" />
