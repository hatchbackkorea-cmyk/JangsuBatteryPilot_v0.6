                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Avinox FIT + 우리 BLE → 클린 FIT 업로드" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <Button android:id="@+id/btnFeedbackStrava" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:text="Strava 연결 / FIT 업로드" android:textStyle="bold" />
