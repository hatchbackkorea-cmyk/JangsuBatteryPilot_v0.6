<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ViewFlipper
        android:id="@+id/pagerFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 0. 지도 / 코스 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="지도 / 코스"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCourseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="GPS / 코스 상태"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="코스 고도 프로필"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <com.seungjae.jangsu280battery.ElevationProfileView
                        android:id="@+id/profileView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/tvNextPoi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="다음 포인트"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCourseMenu"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="코스 / 충전 계획 관리"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- 1. 주행 메인 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvGpsStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="주행 대기"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v0.11.0"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/panel_hero_bg"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="현재 위치"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvCurrentKm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="0.0 km"
                                android:textColor="@color/text_primary"
                                android:textSize="31sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="예측 배터리"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvBattery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:text="100%"
                                android:textColor="@color/good"
                                android:textSize="48sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/progressBattery"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="100" />
                    <TextView
                        android:id="@+id/tvBatteryRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="예상 범위"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/pill_bg"
                            android:gravity="center"
                            android:text="속도 -"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvFinishEta"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/pill_bg"
                            android:gravity="center"
                            android:text="종점"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 배터리 판단: 큰 상태 + 오른쪽 3단 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">
                    <TextView
                        android:id="@+id/tvRiskStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="여유"
                        android:textColor="@color/good"
                        android:textSize="34sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvRiskDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:lineSpacingExtra="2dp"
                        android:text="종점 20%\n목표 15%\n여유 5%"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 실제 배터리: 설명문 삭제, 값 + 마이크 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="실제 배터리"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvActualBattery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="37sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnMicBattery"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/mic_button_bg"
                        android:contentDescription="배터리 음성 입력"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mic" />
                    <TextView
                        android:id="@+id/tvActualDetail"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvMicHint"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/btnUndoActual"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 다음 지점: 큰 지점명 + 오른쪽 3단 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="다음 지점"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvNextCheckpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="종점"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvNextCheckpointDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:lineSpacingExtra="2dp"
                        android:text="9.2 km 남음\n종점 예상 20%\nETA --:--"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvEta"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 다음 업힐: 큰 라벨 + 오른쪽 3단 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">
                    <TextView
                        android:id="@+id/tvNextClimb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="다음 업힐"
                        android:textColor="@color/text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvNextClimbDetail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:lineSpacingExtra="2dp"
                        android:text="1.4 km 후\n길이 2.8 km\n평균 7.5%"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvElevationAhead"
                        android:layout_width="0dp"
                        android:layout_height="31dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_bg"
                        android:gravity="center"
                        android:text="10km 고도"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvTenKmBattery"
                        android:layout_width="0dp"
                        android:layout_height="31dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_bg"
                        android:gravity="center"
                        android:text="10km 후"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAssist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="페이스 안내"
                    android:textColor="@color/good"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChargeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnChargeToggle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="⚡ 충전 시작"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnRideToggle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1.1"
                        android:text="▶ 주행 시작"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSpeakNow"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:text="현재 상태 음성 안내"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. 설정 / 정보 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="설정 / 정보"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="설정과 과거 FIT/GPX 학습은 여기에서 관리합니다."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnSettingsMenu"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:text="앱 설정 열기"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnOpenHistorical"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:text="과거 FIT / GPX 학습"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- 3. 피드백: 지도+그래프 상세 UI는 후속, v0.11.0은 데이터 기반부터 보존 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="피드백"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/panel_bg"
                    android:padding="14dp"
                    android:text="v0.11.0은 FIT 원본과 거리·GPS·고도·속도·케이던스·라이더 파워·모터 파워 시계열을 보존합니다.\n\n다음 단계에서 거리/고도 그래프 슬라이드 ↔ 지도 위치 동기화, 배터리 소모 경로 색상, 무동력 다운힐 구분을 이 데이터에 연결합니다."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnRideReport"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="현재 / 최근 주행 리포트"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <TextView
        android:id="@+id/tvPagerIndicator"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="○  ●  ○  ○   주행"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
