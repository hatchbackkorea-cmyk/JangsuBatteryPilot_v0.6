            </LinearLayout>
        </ScrollView>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="18dp" android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="모바일 배포" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />
