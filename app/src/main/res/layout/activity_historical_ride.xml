<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnHistoricalBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="← 설정" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="과거 라이딩 학습"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_accent_bg"
            android:orientation="vertical"
            android:padding="15dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="기록 파일 가져오기"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="정식 개인학습은 Avinox FIT + 우리 앱 주행 ZIP을 함께 넣는 검증 학습을 권장합니다. 거리·고도·파워는 FIT, 실제 SOC·모드는 ZIP을 기준으로 시간축에서 결합합니다."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnImportVerifiedPair"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="✅ 검증 학습 가져오기 · FIT + 앱 ZIP" />
            <Button
                android:id="@+id/btnImportAuxFit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="🟦 FIT 단독 보조학습 · 여러 개 선택" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="B급 FIT 단독 보조학습은 거리·고도·속도·Rider/Motor Power·Cadence만 사용합니다. SOC·모드별 배터리 소비계수는 수정하지 않습니다."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnImportFitHistory"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="FIT 여러 개 가져오기" />
                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />
                <Button
                    android:id="@+id/btnImportGpxHistory"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="GPX 가져오기" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelHistoricalAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="분석 결과"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvHistoricalAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="파일 분석 결과"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelHistoricalBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="배터리 사용량"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="시작·종료 잔량 또는 총 사용량을 입력하세요. 총 사용량을 입력하면 시작·종료값보다 우선합니다."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etHistoricalStartBattery"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="시작 %"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text="100"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <EditText
                    android:id="@+id/etHistoricalEndBattery"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="종료 %"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <EditText
                    android:id="@+id/etHistoricalUsedBattery"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="사용 %"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddHistoricalBatteryPoint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="+ 중간 배터리 / 충전 지점 추가" />
            <LinearLayout
                android:id="@+id/llHistoricalBatteryPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnTrainHistoricalRide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="이 라이딩을 학습에 사용" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="15dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="학습된 라이딩 · A급 / B급"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvHistoricalRideCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0개"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/llHistoricalRideList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="※ A급 검증 학습은 FIT+ZIP을 교차검사하고 SOC·모드 배터리 모델까지 학습합니다. B급 FIT 단독 보조학습은 지형/파워 특성만 보조하며 배터리 소비계수는 건드리지 않습니다. 완충 직후 100→98% SOC 구간은 A급 학습에서 자동 제외합니다."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
